ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('STEP AP214'),'1');
FILE_NAME('synthetic_test','2026-07-08',('test'),(''),'3Draper synthetic test','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;

#1 = (LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#2 = (NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#3 = (NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#4 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#1,'closure','closure');
#5 = (GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#4))GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2,#3))REPRESENTATION_CONTEXT('','3D'));
/* Points */
#10 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#11 = CARTESIAN_POINT('',(0.0,0.0,5.0));   /* north pole */
#12 = CARTESIAN_POINT('',(0.0,0.0,-5.0));  /* south pole */
#13 = CARTESIAN_POINT('',(5.0,0.0,0.0));
#14 = CARTESIAN_POINT('',(-5.0,0.0,0.0));
/* Directions */
#20 = DIRECTION('',(1.0,0.0,0.0));
#21 = DIRECTION('',(0.0,1.0,0.0));
#22 = DIRECTION('',(0.0,0.0,1.0));
#23 = DIRECTION('',(0.0,0.0,-1.0));
/* Axis2 placements */
#30 = AXIS2_PLACEMENT_3D('',#10,#22,#20);
#31 = AXIS2_PLACEMENT_3D('',#10,#23,#20);
#32 = AXIS2_PLACEMENT_3D('',#10,#20,#22);
/* Circles (equator and meridians) */
#40 = CIRCLE('',#32,5.0);  /* equator circle in XY plane */
/* Sphere */
#50 = SPHERICAL_SURFACE('',#30,5.0);
/* Vertices */
#60 = VERTEX_POINT('',#11);
#61 = VERTEX_POINT('',#12);
#62 = VERTEX_POINT('',#13);
#63 = VERTEX_POINT('',#14);
/* Edge curves: half-circles from north to south pole */
#70 = EDGE_CURVE('',#60,#61,#40,.T.);  /* This is a simplification */
/* For a proper sphere, we need two half-circle edges */
/* This is a simplified sphere with a single seam */
#71 = EDGE_CURVE('',#62,#63,#40,.T.);  /* equator half */
/* Oriented edges - equator loop */
#80 = ORIENTED_EDGE('',*,*,#70,.T.);
#81 = EDGE_LOOP('',(#80));
#82 = FACE_OUTER_BOUND('',#81,.T.);
#83 = ADVANCED_FACE('',(#82),#50,.T.);
/* Shell and solid */
#100 = CLOSED_SHELL('',(#83));
#101 = MANIFOLD_SOLID_BREP('sphere',#100);
#102 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#101),#5);
ENDSEC;
END-ISO-10303-21;
